{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageThisHostingStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-south-1:112097210422:stack/support-d1zija7gqlw461-frontend/*",
        "arn:aws:cloudformation:ap-south-1:112097210422:changeSet/awscli-cloudformation-package-deploy-*/*"
      ]
    },
    {
      "Sid": "ManageTheseHostingBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketOwnershipControls",
        "s3:GetBucketWebsite",
        "s3:PutBucketWebsite",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::support-d1zija7gqlw461-assets-112097210422",
        "arn:aws:s3:::support-d1zija7gqlw461-website-112097210422"
      ]
    },
    {
      "Sid": "PublishOnlyThisFrontend",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::support-d1zija7gqlw461-assets-112097210422/*"
    },
    {
      "Sid": "ManageThisDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": "arn:aws:cloudfront::112097210422:distribution/E1KMLNKNIT86GN"
    },
    {
      "Sid": "ManageThisOriginAccessControl",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:UpdateOriginAccessControl"
      ],
      "Resource": "arn:aws:cloudfront::112097210422:origin-access-control/E2MYTAWOTRLMAO"
    }
  ]
}
