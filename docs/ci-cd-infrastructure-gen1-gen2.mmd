flowchart TB
  subgraph workflow["GitHub Actions workflow — runs independently in EACH repository"]
    direction LR
    trigger["Push main / workflow_dispatch"] --> runner["Ubuntu / Node 22 / npm 11.13.0"]
    runner --> validate["npm ci; npm run validate<br/>Typecheck, runtime/UI tests, synthesis"]
    validate --> oidc["GitHub OIDC → project IAM role<br/>Temporary AWS credentials / ap-south-1"]
    oidc --> plugins["Gen 1 only: configure CLI and scan plugins"]
    plugins --> hosting["hosting.cjs prepare<br/>CloudFormation frontend stack"]
    hosting --> backend["Deploy this repository's backend<br/>Use the matching implementation below"]
    backend --> outputs["amplify_outputs.json<br/>This deployment's endpoints and Cognito IDs"]
    outputs --> packages["Gen 1 only: verify deployed Lambda packages"]
    packages --> smoke["smoke-test.cjs<br/>REST, GraphQL, WebSocket, auth, comments, stream push"]
    smoke --> build["npm run frontend:build<br/>Uses this deployment's outputs"]
    build --> publish["hosting.cjs publish<br/>Upload frontend/dist to private S3"]
    publish --> checks["check-hosting.cjs<br/>HTTPS asset hashes, manifest, redirect, private origin"]
  end
  workflow -. "if: always() — also after failure" .-> evidence["Upload available deployment-evidence<br/>Outputs, synthesis, live API and hosting results<br/>Retention: 14 days"]

  subgraph implementations["Backend implementations — separate apps and stack sets; no cross-project data flow"]
    direction TB
    subgraph gen1["amplify-gen1-fullstack / environment dev"]
      direction LR
      source1["amplify/backend/<br/>Categories, SDL, overrides, custom CDK"] --> deploy1["node scripts/deploy.cjs<br/>amplify init; amplify push --yes"]
      deploy1 --> stacks1["CloudFormation root + category stacks"]
      stacks1 --> output1["deploy.cjs exports amplify_outputs.json"]
    end
    subgraph gen2["amplify-gen2-fullstack / branch main"]
      direction LR
      source2["amplify/backend.ts<br/>TypeScript factories + CDK"] --> deploy2["ampx pipeline-deploy<br/>--branch main --app-id AMPLIFY_APP_ID"]
      deploy2 --> stacks2["CloudFormation / CDK resource stacks"]
      stacks2 --> output2["ampx generate outputs<br/>amplify_outputs.json"]
    end
    subgraph migrated["amplify-gen1-to-gen2-migration / branch main"]
      direction LR
      source3["Repaired Gen 2 source<br/>TypeScript factories + CDK"] --> deploy3["ampx pipeline-deploy<br/>Separate app ID / main branch"]
      deploy3 --> stacks3["Independent CloudFormation / CDK stacks"]
      stacks3 --> output3["ampx generate outputs<br/>amplify_outputs.json"]
    end
  end

  subgraph infrastructure["Infrastructure pattern repeated in each project — isolated resources"]
    direction LR
    identity["Service inventory:<br/>Cognito / API Gateway REST / AppSync / Lambda"]
    tickets[("Ticket table<br/>Tickets + comments")]
    tickets --> stream["DynamoDB Stream"] --> socket["ticketSocketHandler<br/>Owner / Agents / expiry filter"]
    connections[("Connections table")] --- socket
    socket --> websocket["API Gateway WebSocket"] --> browser["Signed-in browser"]
    browser --> cloudfront["CloudFront HTTPS"]
    cloudfront -->|"OAC origin access"| assets[("Private S3 assets")]
    redirect["Separate S3 website bucket"] -->|"301 redirect"| cloudfront
  end
  isolation["Migrated Gen 2 deploys independently.<br/>No Gen 1 users or data are transferred."]
  failure["Failed steps stop later deployment and publishing.<br/>Browser E2E checks are separate from this workflow."]
